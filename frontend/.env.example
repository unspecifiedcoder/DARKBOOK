# WalletConnect Project ID (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Matcher WebSocket URL
NEXT_PUBLIC_MATCHER_WS_URL=ws://localhost:8080

# Matcher API URL (for encrypted order submission)
NEXT_PUBLIC_MATCHER_API_URL=http://localhost:3001

# Matcher's ECDH public key (hex)
NEXT_PUBLIC_MATCHER_PUBKEY=

# Contract addresses (Monad Testnet)
NEXT_PUBLIC_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
