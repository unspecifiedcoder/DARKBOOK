# Monad RPC URL
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Matcher's wallet private key (for submitting settlement txs)
MATCHER_PRIVATE_KEY=0x

# Contract addresses
ENGINE_ADDRESS=0x
VAULT_ADDRESS=0x

# Batch settlement config
BATCH_INTERVAL_MS=2000
MAX_MATCHES_PER_BATCH=16

# ECDH private key for encrypted order relay (32 bytes hex, no 0x prefix)
ECDH_PRIVATE_KEY=

# WebSocket port for indexer API
WS_PORT=8080
